    <worksheet name='02_CarreraPrecios_SalariosViviendas'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Carrera de Precios: Salarios vs Vivienda (Base 100 = 2015)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Comparativa_Vivienda_Salario' name='federated.1jauko90xit8l817iqodx11jd5sv' />
          </datasources>
          <datasource-dependencies datasource='federated.1jauko90xit8l817iqodx11jd5sv'>
            <column caption='Anio' datatype='integer' name='[anio]' role='measure' type='quantitative' />
            <column-instance column='[indice_salario]' derivation='Avg' name='[avg:indice_salario:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ipv]' derivation='Avg' name='[avg:ipv:qk]' pivot='key' type='quantitative' />
            <column caption='Indice Salario' datatype='real' name='[indice_salario]' role='dimension' type='ordinal' />
            <column caption='Ipv' datatype='real' name='[ipv]' role='dimension' type='ordinal' />
            <column-instance column='[anio]' derivation='None' name='[none:anio:qk]' pivot='key' type='quantitative' />
            <column-instance column='[indice_salario]' derivation='None' name='[none:indice_salario:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ipv]' derivation='None' name='[none:ipv:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1jauko90xit8l817iqodx11jd5sv].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1jauko90xit8l817iqodx11jd5sv].[avg:indice_salario:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1jauko90xit8l817iqodx11jd5sv].[avg:ipv:qk]&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.1jauko90xit8l817iqodx11jd5sv].[:Measure Names]' direction='ASC'>
